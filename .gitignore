# macOS writes one of these into every folder Finder opens, which on an external
# volume means all of them. They would otherwise block publish.sh, whose
# cleanliness guard refuses to commit while anything outside app_data is dirty.
.DS_Store
**/.DS_Store

# Raw NCAA play-by-play is 8.8 GB and stays out of the repository.
/data/*

# The DERIVED history does not: 42 MB of rally tables and team box scores for
# 2021-2025, which is everything the pipeline needs to rebuild those seasons.
# Without them a fresh machine can only build the current season, and publishing
# that would delete five seasons from the app. Downloading them once, with the
# clone, is cheaper than re-deriving 8.8 GB that is no longer reachable anyway --
# stats.ncaa.org now denies every /teams/<id> path.
#
# The current season is deliberately excluded: it is rebuilt on every update and
# would churn constantly.
# Per-hitter in-system kill share for 2022-2025, derived from the touch play-by-play
# that is no longer reachable. Small, and the reference distributions depend on it.
!/data/in_system_kills.parquet

!/data/rallies/
/data/rallies/*
# Per-hitter in-system kill share for 2022-2025, derived from the touch play-by-play
# that is no longer reachable. Small, and the reference distributions depend on it.
!/data/in_system_kills.parquet

!/data/rallies/wvb_rallies_div1_202[1-5].parquet

!/data/ncaavolleyballr/
/data/ncaavolleyballr/*
!/data/ncaavolleyballr/data-csv/
/data/ncaavolleyballr/data-csv/*
!/data/ncaavolleyballr/data-csv/wvb_teammatch_div1_202[0-5].csv

__pycache__/
*.pyc
.venv/

# Working clone of the ncaavolleyballr R package, created by the old
# scripts/fetch_season.sh route. A build artifact, not source.
.ncaavolleyballr-src/
